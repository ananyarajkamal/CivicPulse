# ============================================================
# CivicPulse — Application Environment Configuration Template
# Copy this file to .env and fill in your local values.
# NEVER commit the actual .env file or real secrets to Git.
# ============================================================

# --- Application ---
APP_NAME="CivicPulse"
APP_VERSION="0.1.0"
DEBUG=False

# --- Database (Supabase PostgreSQL / Local PostgreSQL) ---
# Example: postgresql+asyncpg://postgres:password@localhost:5432/civicpulse
DATABASE_URL="postgresql+asyncpg://postgres:your_password@localhost:5432/civicpulse"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Authentication ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="your-random-32-byte-hex-jwt-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Intelligence Providers (Phase 4+) ---
GEMINI_API_KEY=""
GROQ_API_KEY=""

# --- Frontend & CORS Configuration ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
ALLOWED_ORIGINS="http://localhost:3000"

# --- Geocoding Proxy ---
NOMINATIM_USER_AGENT="CivicPulse/0.1.0 (contact@civicpulse.org)"

# --- Rate Limits ---
RATE_LIMIT_COMPLAINT_SUBMIT="5/minute"
RATE_LIMIT_TRACKING="30/minute"
RATE_LIMIT_GEOCODE="20/minute"
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_AUTHENTICATED="120/minute"

# ==============================================================
# CivicPulse Backend — Environment Variables
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# NEVER share SUPABASE_SERVICE_ROLE_KEY or JWT_SECRET_KEY.
# ==============================================================

# --- Application ---
APP_NAME=CivicPulse
APP_VERSION=0.1.0
DEBUG=false

# --- Supabase / Database ---
# Get these from your Supabase project settings → API
DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # BACKEND ONLY — never expose to frontend
SUPABASE_ANON_KEY=eyJ...           # Public key — used for RLS-gated reads

# --- Authentication ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_a_secure_random_value_minimum_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- AI Providers (Phase 4+) ---
# Leave blank if not yet configured. App will not call AI in Phase 1.
GEMINI_API_KEY=
GROQ_API_KEY=

# --- CORS ---
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# --- Geocoding ---
# Nominatim User-Agent (required by Nominatim usage policy)
NOMINATIM_USER_AGENT=CivicPulse/0.1.0 (contact@example.com)

# --- Email Notifications ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
FROM_EMAIL=CivicPulse <notifications@civicpulse.gov>
FRONTEND_BASE_URL=http://localhost:3000
